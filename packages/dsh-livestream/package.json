{
  "name": "dsh-livestream",
  "version": "0.1.0",
  "description": "DSH 直播插件：直播舞台（OBS 浏览器源）和 Agent 控制舞台的工具。",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/agent.js",
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "soul"
  ],
  "keywords": [
    "dsh-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "node build.mjs && node lib/dev.js"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "24.10.1",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.5",
    "typescript": "6.0.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "long": "5.3.2",
    "protobufjs": "8.8.0",
    "tiktok-live-connector": "2.5.0",
    "ws": "8.21.3"
  }
}
