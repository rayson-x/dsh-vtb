{
  "name": "aivtb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dsh": "node scripts/dsh.mjs",
    "deps:fetch": "node scripts/fetch-dependencies.mjs",
    "plugin:check": "npm --prefix packages/dsh-livestream run check",
    "plugin:build": "npm --prefix packages/dsh-livestream run build",
    "plugin:test": "npm --prefix packages/dsh-livestream test",
    "scene-host:check": "npm --prefix packages/scene-host run check",
    "scene-host:test": "npm --prefix packages/scene-host test",
    "scene-package:check": "npm --prefix packages/scene-package run check",
    "scene-package:test": "npm --prefix packages/scene-package test",
    "plugin:install": "node scripts/dsh.mjs plugin --profile web add ./packages/dsh-livestream",
    "stage": "npm --prefix packages/dsh-livestream run dev",
    "stage:demo": "npm --prefix packages/dsh-livestream run dev -- --demo",
    "stage:voice": "npm --prefix packages/dsh-livestream run build && node --env-file=.env packages/dsh-livestream/lib/dev.js",
    "stage:graphics": "node packages/dsh-livestream/scripts/import-graphics.mjs",
    "live": "npm --prefix packages/dsh-livestream run build && node --env-file=.env scripts/dsh.mjs --profile live",
    "console": "npm --prefix packages/dsh-livestream run build && node packages/dsh-livestream/lib/console.js",
    "input:bilibili": "node packages/dsh-livestream/scripts/input-bilibili.mjs",
    "input:douyin": "node scripts/input-douyin.mjs",
    "input:tiktok": "node scripts/input-tiktok.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2"
  }
}
