# 复制成仓库根目录的 .env。没有这个文件时，舞台、演示和控制台照样能开。
# 填了密钥的 .env 不要提交。

# DSH 模型密钥，舞台上导播/嘴替的短调用也读它。
# 不填：控制台能开；点「开播」后模型请求会失败，舞台进程还在。
DEEPSEEK_API_KEY=

# 可选。两个都有才会出声；缺任何一个就按字数估时长，只亮字幕。
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# 可选，默认 eleven_multilingual_v2
# ELEVENLABS_MODEL_ID=
# 直播可独立选低延迟模型；留空沿用上面的模型，例如 eleven_flash_v2_5
# ELEVENLABS_LIVE_MODEL_ID=

# 可选。graphic_pick 打分用。剪辑类工具目前没挂给主播。
# TYPESAFE_API_KEY=

# v2 模型共享预算：四岗位、独立首响及重试共用，按大脑进程累计。
# 到限暂停模型岗位，保留当前播放；需主人重启大脑重新开始。
# 不包括 ElevenLabs 等独立媒体服务费用，也不是人民币价格上限。
# AIVTB_MODEL_REQUESTS=300
# AIVTB_MODEL_INPUT_BYTES=10000000
# AIVTB_MODEL_REQUEST_BYTES=300000
# AIVTB_MODEL_OUTPUT_TOKENS=150000
# AIVTB_MODEL_DURATION_MS=3600000
