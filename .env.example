# 复制成仓库根目录的 .env。没有这个文件时，舞台、演示和控制台照样能开。
# 填了密钥的 .env 不要提交。

# DSH 模型密钥，舞台上导播/嘴替的短调用也读它。
# 不填：控制台能开；点「开播」后模型请求会失败，舞台进程还在。
DEEPSEEK_API_KEY=

# 可选。两个都有才会出声；缺任何一个就按字数估时长，只亮字幕。
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# 可选，默认 eleven_multilingual_v2
# ELEVENLABS_MODEL_ID=

# 可选。graphic_pick 打分用。剪辑类工具目前没挂给主播。
# TYPESAFE_API_KEY=
